<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles Shaders/*.hlsl to SPIR-V and writes ClientPlugin/Render/Shaders/ShaderBytecode.g.cs.
       A development tool only: not part of the plugin (Vulkan.xml only lists ClientPlugin in SourceDirectories). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>ShaderCompiler</RootNamespace>
  </PropertyGroup>
</Project>
