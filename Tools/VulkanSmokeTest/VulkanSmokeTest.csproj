<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone test of the plugin's Vulkan device layer, outside the game.
       Not part of the plugin: Vulkan.xml only lists ClientPlugin in SourceDirectories. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>VulkanSmokeTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../ClientPlugin/Render/Vulkan/*.cs" Link="Linked/Vulkan/%(Filename)%(Extension)" />
    <Compile Include="../../ClientPlugin/Render/Platform/Sdl3.cs" Link="Linked/Platform/Sdl3.cs" />
    <Compile Include="../../ClientPlugin/Render/Textures/DdsLoader.cs" Link="Linked/Textures/DdsLoader.cs" />
    <Compile Include="../../ClientPlugin/Render/Textures/TextureData.cs" Link="Linked/Textures/TextureData.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>

  <!-- Only the plain data types (MyAdapterInfo, Vector2I) are used from these -->
  <ItemGroup>
    <Reference Include="VRage">
      <HintPath>$(Bin64Dir)VRage.dll</HintPath>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(Bin64Dir)VRage.Math.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
